<?xml version="1.0" encoding="UTF-8"?> <!-- Declares this file as UTF-8 XML. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"> <!-- Opens the Maven project description. -->
    <modelVersion>4.0.0</modelVersion> <!-- Selects the current Maven project-file format. -->
    <parent> <!-- Inherits managed plugin and dependency versions from Spring Boot. -->
        <groupId>org.springframework.boot</groupId> <!-- Identifies the organization that publishes Spring Boot. -->
        <artifactId>spring-boot-starter-parent</artifactId> <!-- Uses Spring Boot's Maven parent project. -->
        <version>4.1.1</version> <!-- Selects the Spring Boot release generated by Spring Initializr. -->
        <relativePath/> <!-- Tells Maven to find the parent from its repositories. -->
    </parent> <!-- Ends the parent project settings. -->
    <groupId>com.example</groupId> <!-- Gives this project its organization-style package name. -->
    <artifactId>student-registration</artifactId> <!-- Gives this project its Maven name. -->
    <version>0.0.1-SNAPSHOT</version> <!-- Marks this project version as a development snapshot. -->
    <name>student-registration</name> <!-- Sets the friendly project name. -->
    <description>Beginner student registration system</description> <!-- Describes the project in Maven output. -->
    <properties> <!-- Starts shared settings used by Maven plugins. -->
        <java.version>21</java.version> <!-- Compiles the project using Java 21 language features. -->
    </properties> <!-- Ends the shared Maven settings. -->
    <dependencies> <!-- Starts the list of libraries this project needs. -->
        <dependency> <!-- Adds Spring Data JPA for repository and database support. -->
            <groupId>org.springframework.boot</groupId> <!-- Selects a library published by Spring Boot. -->
            <artifactId>spring-boot-starter-data-jpa</artifactId> <!-- Adds Spring Data JPA and Hibernate. -->
        </dependency> <!-- Ends the JPA dependency. -->
        <dependency> <!-- Adds Jakarta Bean Validation support. -->
            <groupId>org.springframework.boot</groupId> <!-- Selects a library published by Spring Boot. -->
            <artifactId>spring-boot-starter-validation</artifactId> <!-- Adds rules such as NotBlank, Email, and Min. -->
        </dependency> <!-- Ends the validation dependency. -->
        <dependency> <!-- Adds the Spring MVC web server and REST support. -->
            <groupId>org.springframework.boot</groupId> <!-- Selects a library published by Spring Boot. -->
            <artifactId>spring-boot-starter-webmvc</artifactId> <!-- Adds Spring Web MVC for HTTP endpoints and static files. -->
        </dependency> <!-- Ends the web dependency. -->
        <dependency> <!-- Adds the driver Spring uses to connect to MySQL. -->
            <groupId>com.mysql</groupId> <!-- Selects the MySQL organization. -->
            <artifactId>mysql-connector-j</artifactId> <!-- Adds the MySQL JDBC driver. -->
            <scope>runtime</scope> <!-- Includes the driver when the application runs. -->
        </dependency> <!-- Ends the MySQL driver dependency. -->
        <dependency> <!-- Adds JPA testing tools for future tests. -->
            <groupId>org.springframework.boot</groupId> <!-- Selects a library published by Spring Boot. -->
            <artifactId>spring-boot-starter-data-jpa-test</artifactId> <!-- Adds test support for Spring Data JPA. -->
            <scope>test</scope> <!-- Keeps this testing library out of the running application. -->
        </dependency> <!-- Ends the JPA test dependency. -->
        <dependency> <!-- Adds validation testing tools for future tests. -->
            <groupId>org.springframework.boot</groupId> <!-- Selects a library published by Spring Boot. -->
            <artifactId>spring-boot-starter-validation-test</artifactId> <!-- Adds test support for bean validation. -->
            <scope>test</scope> <!-- Keeps this testing library out of the running application. -->
        </dependency> <!-- Ends the validation test dependency. -->
        <dependency> <!-- Adds Spring MVC testing tools for future web tests. -->
            <groupId>org.springframework.boot</groupId> <!-- Selects a library published by Spring Boot. -->
            <artifactId>spring-boot-starter-webmvc-test</artifactId> <!-- Adds test support for Spring MVC endpoints. -->
            <scope>test</scope> <!-- Keeps this testing library out of the running application. -->
        </dependency> <!-- Ends the web test dependency. -->
    </dependencies> <!-- Ends the project dependency list. -->
    <build> <!-- Starts the settings that control how Maven builds this project. -->
        <plugins> <!-- Starts the list of Maven build plugins. -->
            <plugin> <!-- Adds the Spring Boot packaging and run commands. -->
                <groupId>org.springframework.boot</groupId> <!-- Selects Spring Boot's Maven plugin. -->
                <artifactId>spring-boot-maven-plugin</artifactId> <!-- Creates an executable Spring Boot jar. -->
            </plugin> <!-- Ends the Spring Boot plugin. -->
        </plugins> <!-- Ends the Maven plugin list. -->
    </build> <!-- Ends the build settings. -->
</project> <!-- Ends the Maven project description. -->
